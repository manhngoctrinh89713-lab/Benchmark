      "repo_id": {
        "title": "Repo Id",
        "type": "string"
      },
      "operation": {
        "default": "start",
        "title": "Operation",
        "type": "string"
      },
      "revision": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Revision"
      }
    },
    "required": [
      "repo_id"
    ],
    "title": "git_cherry_pickArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

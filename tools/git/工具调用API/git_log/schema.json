{
  "name": "git_log",
  "description": "读取提交历史，limit为1..100。",
  "inputSchema": {
    "properties": {
      "repo_id": {
        "title": "Repo Id",
        "type": "string"
      },
      "revision": {
        "default": "HEAD",
        "title": "Revision",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "title": "Limit",
        "type": "integer"
      }
    },
    "required": [
      "repo_id"
    ],
    "title": "git_logArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

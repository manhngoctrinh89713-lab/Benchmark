        "type": "string"
      },
      "tag": {
        "title": "Tag",
        "type": "string"
      },
      "revision": {
        "default": "HEAD",
        "title": "Revision",
        "type": "string"
      },
      "message": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }

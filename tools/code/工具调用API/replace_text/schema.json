{
  "name": "replace_text",
  "description": "依次应用old_text/new_text精确替换；可选expected_count默认1，必须命中该次数。全部检查成功才写入，支持预览与哈希校验。",
  "inputSchema": {
    "properties": {
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "path": {
        "title": "Path",
        "type": "string"
      },
      "edits": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Edits",
        "type": "array"
      },
      "expected_sha256": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Sha256"
      },
      "dry_run": {
        "default": false,
        "title": "Dry Run",
        "type": "boolean"
      },
      "validate_syntax": {
        "default": false,
        "title": "Validate Syntax",
        "type": "boolean"
      }
    },
    "required": [
      "project_id",
      "path",
      "edits"
    ],
    "title": "replace_textArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

{
  "name": "execute_transaction",
  "description": "以一个真实SQLite事务执行1..100条SQL。每项含sql和可选parameters，允许读写及DDL；任一失败整体不落盘。不可自行BEGIN/COMMIT或跨库ATTACH。",
  "inputSchema": {
    "properties": {
      "db_id": {
        "title": "Db Id",
        "type": "string"
      },
      "statements": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Statements",
        "type": "array"
      }
    },
    "required": [
      "db_id",
      "statements"
    ],
    "title": "execute_transactionArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

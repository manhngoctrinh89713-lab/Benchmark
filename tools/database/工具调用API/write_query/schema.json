  "inputSchema": {
    "properties": {
      "db_id": {
        "title": "Db Id",
        "type": "string"
      },
      "sql": {
        "title": "Sql",
        "type": "string"
      },
      "parameters": {
        "anyOf": [
          {
            "items": {},
            "type": "array"
          },
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parameters"
      }
    },
    "required": [
      "db_id",
      "sql"
    ],
    "title": "write_queryArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

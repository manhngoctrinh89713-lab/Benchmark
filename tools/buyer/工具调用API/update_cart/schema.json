          "$ref": "#/$defs/CartLine"
        },
        "title": "Items",
        "type": "array"
      },
      "expected_version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Version"
      }
    },
    "required": [
      "merchant_id",
      "items"
    ],
    "title": "update_cartArguments",
    "type": "object"
  },
  "annotations": {

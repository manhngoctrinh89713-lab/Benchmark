      "CartLine": {
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "quantity"
        ],
        "title": "CartLine",
        "type": "object"
      }
    },
    "properties": {

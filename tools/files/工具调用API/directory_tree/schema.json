{
  "name": "directory_tree",
  "description": "读取目录树，max_depth为1..20，默认4层；深度边界以depth_limited标记。可排除模式匹配的条目及其子树。最多遍历10000项。",
  "inputSchema": {
    "properties": {
      "path": {
        "default": ".",
        "title": "Path",
        "type": "string"
      },
      "max_depth": {
        "default": 4,
        "title": "Max Depth",
        "type": "integer"
      },
      "exclude_patterns": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Exclude Patterns"
      }
    },
    "title": "directory_treeArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

      "path": {
        "title": "Path",
        "type": "string"
      },
      "content_base64": {
        "title": "Content Base64",
        "type": "string"
      },
      "overwrite": {
        "default": false,
        "title": "Overwrite",
        "type": "boolean"
      },
      "expected_sha256": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Sha256"
      }
    },
    "required": [
      "path",
      "content_base64"
    ],
    "title": "write_binary_fileArguments",
    "type": "object"

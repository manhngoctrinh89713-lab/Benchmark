{
  "name": "update_draft_attachments",
  "description": "为草稿添加 workspace 文件或按 remove_ids 移除附件；同次移除并添加可替换附件，新附件获得新 ID。单个附件最多 25 MiB，总计最多 20 个、50 MiB；保存字节快照。",
  "inputSchema": {
    "properties": {
      "account_name": {
        "title": "Account Name",
        "type": "string"
      },
      "draft_id": {
        "title": "Draft Id",
        "type": "string"
      },
      "attachments": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Attachments"
      },
      "remove_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Remove Ids"
      },
      "expected_version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Version"
      }
    },
    "required": [
      "account_name",
      "draft_id"
    ],
    "title": "update_draft_attachmentsArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

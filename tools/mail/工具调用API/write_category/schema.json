{
  "name": "write_category",
  "description": "创建或修改账户分类；传 category_id 修改，不传则创建。分类名称在账户内唯一，color 为显示颜色文本。",
  "inputSchema": {
    "properties": {
      "account_name": {
        "title": "Account Name",
        "type": "string"
      },
      "name": {
        "title": "Name",
        "type": "string"
      },
      "category_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Category Id"
      },
      "color": {
        "default": "",
        "title": "Color",
        "type": "string"
      },
      "expected_version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Version"
      }
    },
    "required": [
      "account_name",
      "name"
    ],
    "title": "write_categoryArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

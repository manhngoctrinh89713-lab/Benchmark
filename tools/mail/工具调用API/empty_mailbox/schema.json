      },
      "mailbox": {
        "title": "Mailbox",
        "type": "string"
      },
      "permanent": {
        "default": false,
        "title": "Permanent",
        "type": "boolean"
      }
    },
    "required": [
      "account_name",
      "mailbox"
    ],
    "title": "empty_mailboxArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

      "account_name": {
        "title": "Account Name",
        "type": "string"
      },
      "name": {
        "title": "Name",
        "type": "string"
      },
      "parent_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parent Id"
      }
    },
    "required": [

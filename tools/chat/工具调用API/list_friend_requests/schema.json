  "inputSchema": {
    "properties": {
      "direction": {
        "default": "incoming",
        "title": "Direction",
        "type": "string"
      },
      "status": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "pending",
        "title": "Status"
      },
      "offset": {
        "default": 0,
        "title": "Offset",
        "type": "integer"
      },
      "limit": {
        "default": 20,
        "title": "Limit",
        "type": "integer"
      }
    },
    "title": "list_friend_requestsArguments",
    "type": "object"
  },
  "annotations": {

        "type": "string"
      },
      "attachment_id": {
        "title": "Attachment Id",
        "type": "string"
      },
      "save_path": {
        "title": "Save Path",
        "type": "string"
      }
    },
    "required": [
      "chat_id",
      "message_id",
      "attachment_id",
      "save_path"

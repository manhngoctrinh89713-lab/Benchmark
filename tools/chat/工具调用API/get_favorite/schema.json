  "inputSchema": {
    "properties": {
      "favorite_id": {
        "title": "Favorite Id",
        "type": "string"
      },
      "item_path": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Item Path"
      },
      "offset": {
        "default": 0,
        "title": "Offset",
        "type": "integer"
      },
      "limit": {
        "default": 20,
        "title": "Limit",
        "type": "integer"
      }
    },
    "required": [
      "favorite_id"
    ],
    "title": "get_favoriteArguments",
    "type": "object"
  },
  "annotations": {

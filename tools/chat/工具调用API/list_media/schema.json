          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Chat Id"
      },
      "query": {
        "default": "",
        "title": "Query",
        "type": "string"
      },
      "offset": {
        "default": 0,
        "title": "Offset",
        "type": "integer"
      },
      "limit": {
        "default": 20,
        "title": "Limit",
        "type": "integer"
      }
    },
    "title": "list_mediaArguments",
    "type": "object"
  },

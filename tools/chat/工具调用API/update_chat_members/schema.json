          "type": "string"
        },
        "title": "Member Ids",
        "type": "array"
      },
      "action": {
        "title": "Action",
        "type": "string"
      }
    },
    "required": [
      "chat_id",
      "member_ids",
      "action"
    ],
    "title": "update_chat_membersArguments",
    "type": "object"
  },
  "annotations": {

  "inputSchema": {
    "properties": {
      "user_id": {
        "title": "User Id",
        "type": "string"
      },
      "message": {
        "default": "",
        "title": "Message",
        "type": "string"
      }
    },
    "required": [
      "user_id"
    ],
    "title": "send_friend_requestArguments",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
